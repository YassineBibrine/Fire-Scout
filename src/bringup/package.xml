<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bringup</name>
  <version>0.0.0</version>
  <description>Launch and configuration files for Fire-Scout</description>
  <maintainer email="your.email@domain.com">Fire-Scout Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <depend>firescout_interfaces</depend>
  <depend>simulation</depend>
  <depend>mapping</depend>
  <depend>exploration</depend>
  <depend>response</depend>
  <depend>coordination</depend>
  <depend>monitoring</depend>
  <depend>testing_tools</depend>
  <depend>slam_toolbox</depend>
  <depend>nav2_core</depend>
  <depend>nav2_common</depend>
  <depend>nav2_bt_navigator</depend>
  <depend>nav2_controller</depend>
  <depend>nav2_planner</depend>
  <depend>nav2_behaviors</depend>
  <depend>nav2_waypoint_follower</depend>
  <depend>nav2_velocity_smoother</depend>
  <depend>nav2_lifecycle_manager</depend>
  <depend>nav2_navfn_planner</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>nav2_mppi_controller</depend>
  <depend>dwb_core</depend>
  <depend>rclpy</depend>
  <exec_depend>ros2launch</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
