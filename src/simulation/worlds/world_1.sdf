  <!--
    PHASE 2 - FIRE ENTITY  position (3.0, 2.0) — primary fire (Phase 2 spec)
    Static, no physics. Ignition zone radius ~0.8 m.
  -->
  <model name="fire_entity">
    <static>true</static>
    <pose>3.0 2.0 0.0 0 0 0</pose>
    <link name="fire_base">
      <visual name="base_vis">
        <pose>0 0 0.05 0 0 0</pose>
        <geometry><cylinder><radius>0.25</radius><length>0.10</length></cylinder></geometry>
        <material>
          <ambient>1.0 0.25 0.0 0.9</ambient>
          <diffuse>1.0 0.25 0.0 0.9</diffuse>
          <emissive>0.9 0.15 0.0 1</emissive>
        </material>
      </visual>
    </link>
    <link name="fire_mid">
      <visual name="mid_vis">
        <pose>0 0 0.30 0 0 0</pose>
        <geometry><cylinder><radius>0.15</radius><length>0.40</length></cylinder></geometry>
